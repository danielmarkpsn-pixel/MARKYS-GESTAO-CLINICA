{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "markys-gestao-clinica-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "MarkysApiContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "../../backend/Dockerfile",
          "build_context": "../../backend"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MARKYS_API", "class_name": "MarkysApiContainer" }
    ]
  },
  "exports": {
    "MarkysApiContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
